# ── .env.production.example ───────────────────────────────────────────────────
# Cloud Run: set ALL of these as environment variables in the service console.
# NEVER commit a filled-in copy to version control.
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(50))"

# ── Django core ───────────────────────────────────────────────────────────────
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_KEY
DEBUG=False

# Comma-separated hostnames (no protocol, no trailing slash).
# Must include your Cloud Run *.run.app domain and any custom domain.
ALLOWED_HOSTS=your-service-abc123-uc.a.run.app,api.yourdomain.com

# ── Database (Cloud SQL / PostgreSQL) ─────────────────────────────────────────
# Cloud SQL Auth Proxy (recommended): DB_HOST=/cloudsql/PROJECT:REGION:INSTANCE
# Direct TCP:                         DB_HOST=<private IP>
DB_HOST=/cloudsql/your-project:asia-south1:your-instance
DB_PORT=5432
DB_NAME=ahp_db
DB_USER=ahp_user
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Omit to fall back to in-process LocMemCache (stateless, no persistence).
REDIS_URL=redis://10.x.x.x:6379/0
CACHE_TTL=3600

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (full URL with protocol).
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_CREDENTIALS=True

# ── CSRF ──────────────────────────────────────────────────────────────────────
# Required for Django admin and any session-auth POST requests in production.
# Falls back to CORS_ALLOWED_ORIGINS when not set, which is usually sufficient.
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7
# Recommended: use a dedicated secret separate from SECRET_KEY.
JWT_SECRET_KEY=REPLACE_WITH_SEPARATE_JWT_SECRET

# ── Razorpay (live credentials only) ──────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_REPLACE
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
RAZORPAY_CURRENCY=INR

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_WEB_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=REPLACE_WITH_SMTP_API_KEY
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ── Sentry (error tracking) ───────────────────────────────────────────────────
# Omit to disable Sentry.
SENTRY_DSN=https://REPLACE@oXXXXXX.ingest.sentry.io/XXXXXXX
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Cloud Run / Gunicorn ──────────────────────────────────────────────────────
# PORT is injected automatically by Cloud Run — do NOT set it manually.
# Tune workers for your Cloud Run instance size (vCPUs × 2 + 1 is a safe start).
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30
GUNICORN_LOG_LEVEL=info

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Keep False on Cloud Run — Cloud Logging captures stdout automatically.
LOG_TO_FILE=False

# ── Throttling ────────────────────────────────────────────────────────────────
THROTTLE_ANON_RATE=100/day
THROTTLE_USER_RATE=1000/day
THROTTLE_BURST_RATE=60/min
THROTTLE_AUTH_RATE=10/min
THROTTLE_PAYMENT_CREATE=10/hour
THROTTLE_PAYMENT_VERIFY=20/hour

# ── Feature limits ────────────────────────────────────────────────────────────
DEFAULT_MAX_PROJECTS=2
DEFAULT_ALTERNATIVE_LIMIT=3

# ── App metadata ──────────────────────────────────────────────────────────────
APP_NAME=MCDM Platform
FRONTEND_URL=https://yourdomain.com

# ── DO NOT SET in production ──────────────────────────────────────────────────
# USE_SQLITE=True   ← SQLite only for local dev; omitting this forces PostgreSQL
