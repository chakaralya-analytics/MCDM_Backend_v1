# ── Local development .env ────────────────────────────────────────────────────
# For Cloud Run production, set these as environment variables in the service
# console — DO NOT deploy this file to Cloud Run.

# ── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-key-replace-in-production
DEBUG=True
USE_SQLITE=False

# ── Hosts / CORS ──────────────────────────────────────────────────────────────
# ALLOWED_HOSTS is optional in DEBUG mode (defaults to localhost,127.0.0.1).
# Required when DEBUG=False:
# ALLOWED_HOSTS=ahp-backend-988541302433.asia-south1.run.app,localhost

# CORS_ALLOWED_ORIGINS is only required when DEBUG=False.
# In DEBUG mode, localhost:3000/3001/5173 are allowed automatically.
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Extra origins for local dev (comma-separated, only active when DEBUG=True):
# CORS_DEV_ORIGINS=http://localhost:3002

CORS_ALLOW_CREDENTIALS=True

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Not used when USE_SQLITE=True — fill before switching to Postgres.
DB_HOST=localhost
DB_NAME=ahp_db
DB_USER=ahp_user
DB_PASSWORD=your-db-password-here
DB_PORT=5432

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# ── JWT ───────────────────────────────────────────────────────────────────────
# JWT_SECRET_KEY defaults to SECRET_KEY when not set — set explicitly in prod.
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# ── Throttling (optional — sensible defaults already in settings.py) ──────────
# THROTTLE_ANON_RATE=100/day
# THROTTLE_USER_RATE=1000/day
# THROTTLE_BURST_RATE=60/min
# THROTTLE_AUTH_RATE=10/min
# THROTTLE_PAYMENT_CREATE=10/hour
# THROTTLE_PAYMENT_VERIFY=20/hour

# ── Plans / Quotas ────────────────────────────────────────────────────────────
DEFAULT_MAX_PROJECTS=2
DEFAULT_ALTERNATIVE_LIMIT=3

# ── Razorpay (LIVE keys) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_Swk5hACbRrW1MD
RAZORPAY_KEY_SECRET=fh2dKJOMEO26uT1iGZnZlJjF
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret-here
RAZORPAY_CURRENCY=INR

# ── Firebase (social auth token verification) ─────────────────────────────────
FIREBASE_WEB_API_KEY=AIzaSyCU57lC9AQ6zXz4TvFqickorbIcVWjiz8M

# ── Email ─────────────────────────────────────────────────────────────────────
# console: prints to stdout (good for local dev)
# smtp: fill HOST/PORT/USER/PASSWORD below and switch BACKEND
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-app-password-here
DEFAULT_FROM_EMAIL=noreply@chakaralaya.com

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=MCDM Platform
FRONTEND_URL=http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
# Defaults to DEBUG when DEBUG=True, INFO when DEBUG=False.
# LOG_LEVEL=DEBUG

# ── Static / Media ────────────────────────────────────────────────────────────
# STATIC_URL=/static/
# MEDIA_URL=/media/
