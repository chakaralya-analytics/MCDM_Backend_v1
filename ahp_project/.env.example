# ============================================================
# Copy this file to `.env` and fill in real values.
# Variables marked REQUIRED will cause the app to crash on
# startup if missing — this is intentional (fail-fast).
# ============================================================

# ---- General -----------------------------------------------
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=change-me-to-a-strong-random-secret

# Set to True only for local development. NEVER True in production.
DEBUG=False

# Comma-separated list of allowed hostnames (no protocol, no trailing slash)
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----------------------------------------------
# Set USE_SQLITE=True for local dev (no PostgreSQL required).
# All DB_* vars below are REQUIRED when USE_SQLITE is not True.
USE_SQLITE=False

DB_NAME=ahp_database
DB_USER=ahp_admin
# REQUIRED — never commit a real password
DB_PASSWORD=change-me
# REQUIRED — hostname or IP of the PostgreSQL server
DB_HOST=localhost
DB_PORT=5432

# ---- Redis Cache -------------------------------------------
# Optional — falls back to in-process LocMemCache if not set.
REDIS_URL=redis://localhost:6379/1
CACHE_TTL=3600

# ---- CORS --------------------------------------------------
# REQUIRED in production — comma-separated list of allowed frontend origins.
# Example: https://app.yourdomain.com,https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True

# ---- JWT ---------------------------------------------------
# Optional — defaults to SECRET_KEY. Use a separate value for extra isolation.
# JWT_SECRET_KEY=another-strong-random-secret

# Access token lifetime in minutes (default: 15)
JWT_ACCESS_TOKEN_LIFETIME=15

# Refresh token lifetime in days (default: 7)
JWT_REFRESH_TOKEN_LIFETIME=7

# ---- Rate Limiting -----------------------------------------
THROTTLE_ANON_RATE=100/day
THROTTLE_USER_RATE=1000/day
THROTTLE_BURST_RATE=60/min
# Applied to login and register endpoints specifically
THROTTLE_AUTH_RATE=10/min

# ---- Logging -----------------------------------------------
LOG_LEVEL=INFO
